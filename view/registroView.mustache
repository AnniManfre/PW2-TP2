{{>header}}

<link rel="stylesheet" href="/public/styles/registro.css">

    <h2>Crear Cuenta</h2>

    {{#error}}
    <div class="error">{{error}}</div>
    {{/error}}

    <form method="POST" action="/user/procesarRegistro">
        <div class="section-divider">INFORMACIÓN OBLIGATORIA</div>

        <div class="form-group">
            <label for="nombre_completo">Nombre completo: </label>
            <input type="text" id="nombre_completo" name="nombre_completo" required>
        </div>

        <div class="form-group">
            <label for="anio_nacimiento">Año de nacimiento: </label>
            <input type="number" id="anio_nacimiento" name="año_nacimiento" min="1900" max="2023">
        </div>

        <div class="form-group">
            <label for="sexo">Sexo: </label>
            
            <select id="sexo" name="sexo">
                <option value="Prefiero no decirlo">Prefiero no cargarlo</option>
                <option value="Masculino">Masculino</option>
                <option value="Femenino">Femenino</option>
            </select>
        </div>

        <div class="form-group">
            <label for="pais">País: </label>
            <input type="text" id="pais" name="pais">
        </div>

        <div class="form-group">
            <label for="ciudad">Ciudad: </label>
            <input type="text" id="ciudad" name="ciudad">
        </div>

        <div class="form-group">
            <label for="email">Email: </label>
            <input type="email" id="email" name="email" required>
        </div>

        <div class="form-group">
            <label for="password">Contraseña: </label>
            <input type="password" id="password" name="password" required onkeyup="validarContraseña()">

            <div class="password-requirements">
                <p class="requirements-title">Requisitos de seguridad: </p>
                <ul>
                    <li class="" id="req-length">
                        <span class="requirement-icon">✓</span>
                        <span>Mínimo 8 caracteres.</span>
                    </li>

                    <li class="" id="req-uppercase">
                        <span class="requirement-icon">✓</span>
                        <span>Al menos 1 letra mayúscula (A-Z).</span>
                    </li>

                    <li class="" id="req-number">
                        <span class="requirement-icon">✓</span>
                        <span>Al menos 1 número (0-9).</span>
                    </li>
                </ul>
            </div>

        </div>

        <div class="form-group">
            <label for="password_repeat">Repetir contraseña: </label>
            <input type="password" id="password_repeat" name="password_repeat" required>
        </div>

        <div class="form-group">
            <label for="usuario">Nombre de usuario: </label>
            <input type="text" id="usuario" name="usuario" required>
            <p class="info-text">Entre 3 y 20 caracteres, solo letras y números.</p>
        </div>

        <button type="submit" class="btn">CREAR CUENTA</button>
    </form>

    <div class="text-center" style="margin-top: 25px;">
        ¿Ya tienes cuenta? <a href="/user/login">INICIAR SESIÓN</a>
    </div>

    <script>
        function validarContraseña() {
            const password = document.getElementById('password').value;

            // Mínimo 8 caracteres.
            const reqLength = document.getElementById('req-length');
            if (password.length >= 8) {
                reqLength.classList.add('requirement-checked');
                reqLength.classList.remove('requirement-unchecked');
            } else {
                reqLength.classList.remove('requirement-checked');
                reqLength.classList.add('requirement-unchecked');
            }

            // Al menos 1 mayúscula.
            const reqUppercase = document.getElementById('req-uppercase');
            if (/[A-Z]/.test(password) === true) {
                reqUppercase.classList.add('requirement-checked');
                reqUppercase.classList.remove('requirement-unchecked');
            } else {
                reqUppercase.classList.remove('requirement-checked');
                reqUppercase.classList.add('requirement-unchecked');
            }

            // Al menos 1 número.
            const reqNumber = document.getElementById('req-number');
            if (/[0-9]/.test(password) === true) {
                reqNumber.classList.add('requirement-checked');
                reqNumber.classList.remove('requirement-unchecked');
            } else {
                reqNumber.classList.remove('requirement-checked');
                reqNumber.classList.add('requirement-unchecked');
            }
        }

        document.addEventListener('DOMContentLoaded', validarContraseña);
    </script>

{{>footer}}