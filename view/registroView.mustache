{{>header}}

    <h2>Crear Cuenta</h2>

    {{#error}}
    <div class="error">{{error}}</div>
    {{/error}}

    <form method="POST" action="/PW2-TP2/user/procesarRegistro">
        
        <div class="section-divider">Información Obligatoria</div>

        <div class="form-group">
            <label for="nombre_completo">Nombre Completo</label>
            <input type="text" id="nombre_completo" name="nombre_completo" required>
        </div>

        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required>
        </div>

        <div class="form-group">
            <label for="usuario">Nombre de Usuario</label>
            <input type="text" id="usuario" name="usuario" required>
            <p class="info-text">Entre 3 y 20 caracteres, solo letras y números</p>
        </div>

        <div class="form-group">
            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" required onkeyup="validarContraseña()">
            <div class="password-requirements">
                <p class="requirements-title">Requisitos de seguridad:</p>
                <ul class="requirements-list">
                    <li class="requirement requirement-unchecked" id="req-length">
                        <span class="requirement-icon">✓</span>
                        <span>Mínimo 8 caracteres</span>
                    </li>
                    <li class="requirement requirement-unchecked" id="req-uppercase">
                        <span class="requirement-icon">✓</span>
                        <span>Al menos 1 letra mayúscula (A-Z)</span>
                    </li>
                    <li class="requirement requirement-unchecked" id="req-number">
                        <span class="requirement-icon">✓</span>
                        <span>Al menos 1 número (0-9)</span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="form-group">
            <label for="password_repeat">Repetir Contraseña</label>
            <input type="password" id="password_repeat" name="password_repeat" required>
        </div>

        <div class="section-divider">Información Adicional (Opcional)</div>

        <div class="form-group">
            <label for="año_nacimiento">Año de Nacimiento</label>
            <input type="number" id="año_nacimiento" name="año_nacimiento" min="1900" max="2023">
        </div>

        <div class="form-group">
            <label for="sexo">Sexo</label>
            <select id="sexo" name="sexo">
                <option value="Prefiero no decirlo">Prefiero no decirlo</option>
                <option value="Masculino">Masculino</option>
                <option value="Femenino">Femenino</option>
            </select>
        </div>

        <div class="form-group">
            <label for="pais">País</label>
            <input type="text" id="pais" name="pais">
        </div>

        <div class="form-group">
            <label for="ciudad">Ciudad</label>
            <input type="text" id="ciudad" name="ciudad">
        </div>

        <button type="submit" class="btn">Crear Cuenta</button>
    </form>

    <div class="text-center" style="margin-top: 28px;">
        ¿Ya tienes cuenta? <a href="/PW2-TP2/user/login">Inicia sesión aquí</a>
    </div>

    <style>
        .password-requirements {
            background: var(--surface);
            padding: calc(var(--unit) * 1.5);
            border-radius: var(--radius);
            margin-top: calc(var(--unit) * 1);
            border: 1px solid var(--outline-variant);
        }

        .requirements-title {
            font-size: 0.85em;
            font-weight: 700;
            color: var(--primary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin: 0 0 var(--unit) 0;
        }

        .requirements-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: calc(var(--unit) * 0.5);
        }

        .requirement {
            display: flex;
            align-items: center;
            gap: var(--unit);
            font-size: 0.9em;
            color: var(--on-surface-variant);
            transition: all var(--transition);
        }

        .requirement-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: #f0f0f0;
            color: #999;
            font-size: 0.75em;
            font-weight: 700;
            flex-shrink: 0;
        }

        .requirement-unchecked .requirement-icon {
            background: #e0e0e0;
            color: #999;
        }

        .requirement.requirement-checked {
            color: #22863a;
            font-weight: 500;
        }

        .requirement.requirement-checked .requirement-icon {
            background: #22863a;
            color: white;
        }
    </style>

    <script>
        function validarContraseña() {
            const password = document.getElementById('password').value;

            // Requisito 1: Mínimo 8 caracteres
            const reqLength = document.getElementById('req-length');
            if (password.length >= 8) {
                reqLength.classList.add('requirement-checked');
                reqLength.classList.remove('requirement-unchecked');
            } else {
                reqLength.classList.remove('requirement-checked');
                reqLength.classList.add('requirement-unchecked');
            }

            // Requisito 2: Al menos 1 mayúscula
            const reqUppercase = document.getElementById('req-uppercase');
            if (/[A-Z]/.test(password)) {
                reqUppercase.classList.add('requirement-checked');
                reqUppercase.classList.remove('requirement-unchecked');
            } else {
                reqUppercase.classList.remove('requirement-checked');
                reqUppercase.classList.add('requirement-unchecked');
            }

            // Requisito 3: Al menos 1 número
            const reqNumber = document.getElementById('req-number');
            if (/[0-9]/.test(password)) {
                reqNumber.classList.add('requirement-checked');
                reqNumber.classList.remove('requirement-unchecked');
            } else {
                reqNumber.classList.remove('requirement-checked');
                reqNumber.classList.add('requirement-unchecked');
            }
        }

        // Ejecutar validación al cargar la página (en caso de que haya un error)
        document.addEventListener('DOMContentLoaded', validarContraseña);
    </script>

{{>footer}}
