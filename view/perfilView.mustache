{{>header}}

<link rel="stylesheet" href="/public/styles/perfil.css">

<main class="profile-main">
    {{#error}}
        <div class="error" style="max-width: 600px; margin: 0 auto 20px;">{{error}}</div>
    {{/error}}
    {{#success}}
        <div class="success" style="max-width: 600px; margin: 0 auto 20px;">{{success}}</div>
    {{/success}}

    <div class="profile-grid">
        <div class="profile-left">
            <div class="profile-card card-shadow">
                <div class="profile-avatar-container" onclick="document.getElementById('input-foto-perfil').click();" style="cursor: pointer;" title="Hacé clic para cambiar tu foto de perfil">
                    {{#foto_perfil}}
                    <img src="{{foto_perfil}}" alt="Foto de perfil" class="profile-avatar">
                    {{/foto_perfil}}
                    {{^foto_perfil}}
                    <div class="profile-avatar-placeholder">
                        <span class="material-symbols-outlined avatar-placeholder-icon">person</span>
                    </div>
                    {{/foto_perfil}}
                    <div class="profile-avatar-overlay">
                        <span class="material-symbols-outlined overlay-icon" title="Subir nueva foto">photo_camera</span>
                        {{#foto_perfil}}
                        <a href="/user/eliminarFotoPerfil" onclick="event.stopPropagation();" class="overlay-delete-btn" title="Eliminar foto actual">
                            <span class="material-symbols-outlined delete-icon">delete</span>
                        </a>
                        {{/foto_perfil}}
                    </div>
                    <div class="profile-badge">
                        <span class="material-symbols-outlined badge-icon">star</span>
                    </div>
                </div>

                <form method="POST" action="/user/cambiarFotoPerfil" enctype="multipart/form-data" id="form-foto-perfil" style="display: none;">
                    <input type="file" id="input-foto-perfil" name="foto_perfil" accept="image/*" onchange="document.getElementById('form-foto-perfil').submit();">
                </form>

                <h1 class="profile-name">{{nombre_completo}}</h1>
                <p class="profile-subtitle">{{nivel}} · {{categoria}}</p>
            </div>

            <div class="qr-card card-shadow">
                <div class="location-header">
                    <span class="material-symbols-outlined location-icon">qr_code_2</span>
                    <span class="location-label">Compartir perfil</span>
                </div>
                <div class="qr-body">
                    <a href="/user/publico?id={{id}}" target="_blank" class="qr-link">
                        <img src="/user/qr?id={{id}}" alt="Código QR del perfil" class="qr-image">
                    </a>
                    <p class="qr-caption">Escaneá el QR o tocá la imagen para ver el perfil</p>
                </div>
            </div>
        </div>

        <div class="profile-right">
            <div class="stats-grid">
                <div class="stat-card stat-card-primary card-shadow">
                    <span class="material-symbols-outlined stat-icon">emoji_events</span>
                    <span class="stat-label">Partidas Ganadas</span>
                    <span class="stat-value">{{partidas_ganadas}}</span>
                </div>
                <div class="stat-card stat-card-secondary card-shadow">
                    <span class="material-symbols-outlined stat-icon">target</span>
                    <span class="stat-label">Efectividad</span>
                    <span class="stat-value">{{efectividad}} %</span>
                </div>
                <div class="stat-card stat-card-tertiary card-shadow">
                    <span class="material-symbols-outlined stat-icon">local_fire_department</span>
                    <span class="stat-label">Racha Actual</span>
                    <span class="stat-value">{{racha_actual}}</span>
                </div>
            </div>

            <div class="info-card card-shadow">
                <h2 class="info-card-title">Información Personal</h2>

                <div class="info-grid">
                    <div class="info-item">
                        <span class="material-symbols-outlined info-icon">person</span>
                        <div class="info-content">
                            <span class="info-label">Nombre de Usuario</span>
                            <p class="info-value">@{{usuario}}</p>
                        </div>
                    </div>

                    <div class="info-item">
                        <span class="material-symbols-outlined info-icon">email</span>
                        <div class="info-content">
                            <span class="info-label">Correo Electrónico</span>
                            <p class="info-value">{{email}}</p>
                        </div>
                    </div>

                    {{#anio_nacimiento}}
                    <div class="info-item">
                        <span class="material-symbols-outlined info-icon">cake</span>
                        <div class="info-content">
                            <span class="info-label">Año de Nacimiento</span>
                            <p class="info-value">{{anio_nacimiento}}</p>
                        </div>
                    </div>
                    {{/anio_nacimiento}}

                    {{#sexo}}
                    <div class="info-item">
                        <span class="material-symbols-outlined info-icon">wc</span>
                        <div class="info-content">
                            <span class="info-label">Sexo</span>
                            <p class="info-value">{{sexo}}</p>
                        </div>
                    </div>
                    {{/sexo}}

                    <div class="info-item">
                        <span class="material-symbols-outlined info-icon">verified</span>
                        <div class="info-content">
                            <span class="info-label">Estado</span>
                            <p class="info-value status-valid">✓ Cuenta Validada</p>
                        </div>
                    </div>
                </div>

                <a href="/user/editarPerfil" class="btn-edit">
                    <span class="material-symbols-outlined">edit</span>
                    Editar Perfil
                </a>
            </div>
        </div>
    </div>

    <div class="location-card location-card-full card-shadow">
        <div class="location-header">
            <span class="material-symbols-outlined location-icon">location_on</span>
            <span class="location-label">Ubicación</span>
        </div>
        <div class="location-body">
            {{#pais}}
                <div class="location-map-frame">
                    <iframe
                        width="100%"
                        height="100%"
                        frameborder="0"
                        src="https://maps.google.com/maps?q={{ciudad}},{{pais}}&output=embed"
                        allowfullscreen>
                    </iframe>
                </div>
                <p class="location-text">
                    <span class="material-symbols-outlined">pin_drop</span>
                    {{ciudad}}, {{pais}}
                </p>
            {{/pais}}

            {{^pais}}
                <span class="material-symbols-outlined location-placeholder">public</span>
                <p class="location-text">Ubicación no especificada</p>
            {{/pais}}
        </div>
    </div>

    <div class="action-buttons action-buttons-full">
        <a href="/user/lobby" class="btn-action btn-primary">
            <span class="material-symbols-outlined">home</span>
            Ir al Lobby
        </a>
        <a href="/user/logout" class="btn-action btn-secondary">
            <span class="material-symbols-outlined">logout</span>
            Cerrar Sesión
        </a>
    </div>
</main>

{{>footer}}