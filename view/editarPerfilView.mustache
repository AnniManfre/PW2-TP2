{{>header}}

<link rel="stylesheet" href="/public/styles/perfil.css">
<link rel="stylesheet" href="/public/styles/home.css">

<main class="profile-main">
    <div class="profile-card card-shadow" style="max-width: 600px; margin: 0 auto; padding: 2rem;">
        <h2 style="text-align: center; margin-bottom: 1.5rem;">Editar Perfil</h2>

        {{#error}}
            <div class="error-message" style="color: red; text-align: center; margin-bottom: 1rem;">
                {{error}}
            </div>
        {{/error}}

        <form action="/user/procesarEdicion" method="POST">
            
            <div style="margin-bottom: 1rem;">
                <label>Nombre Completo (Obligatorio)</label>
                <input type="text" name="nombre_completo" value="{{nombre_completo}}" required style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;">
            </div>

            <div style="margin-bottom: 1rem;">
                <label>Año de Nacimiento</label>
                <input type="number" name="anio_nacimiento" value="{{anio_nacimiento}}" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;">
            </div>

            <div style="margin-bottom: 1rem;">
                <label>Sexo</label>
                <select name="sexo" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;">
                    <option value="Masculino">Masculino</option>
                    <option value="Femenino">Femenino</option>
                    <option value="Prefiero no decirlo">Prefiero no decirlo</option>
                </select>
                <small style="color: #666;">Actual: {{sexo}}</small>
            </div>

            <div style="margin-bottom: 1rem;">
                <label>País</label>
                <input type="text" name="pais" value="{{pais}}" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;">
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label>Ciudad</label>
                <input type="text" name="ciudad" value="{{ciudad}}" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;">
            </div>

            <div class="button-grid" style="display: flex; gap: 1rem; justify-content: center; margin-top: 2rem;">
                <a href="/user/perfil" class="btn btn-secondary" style="text-decoration: none; display: inline-block;">CANCELAR</a>
                <button type="submit" class="btn" style="border: none; cursor: pointer; display: inline-block; font-family: inherit; font-size: inherit;">GUARDAR CAMBIOS</button>
            </div>

        </form>
    </div>
</main>

{{>footer}}