{{>header}}

<link rel="stylesheet" href="/public/styles/admin.css">

<div class="admin-section">
    <div class="admin-header">
        <div>
            <h1>👥 Administrar Usuarios</h1>
            <p>Gestión de cuentas de usuario y validación de accesos</p>
        </div>
        <div>
            <a href="/admin/dashboard" class="btn-admin btn-admin-secondary">
                <span class="material-symbols-outlined">arrow_back</span>
                Panel de Control
            </a>
        </div>
    </div>

    {{#mensaje}}
        <div class="alert-box alert-{{mensaje_clase}}">
            <span class="material-symbols-outlined">
                {{#mensaje_clase}}check_circle{{/mensaje_clase}}
            </span>
            {{mensaje}}
        </div>
    {{/mensaje}}

    <div class="table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre Completo</th>
                    <th>Usuario</th>
                    <th>Email</th>
                    <th>Estado Cuenta</th>
                    <th>Rol</th>
                    <th>Puntaje</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                {{#usuarios}}
                <tr>
                    <td><strong>#{{id}}</strong></td>
                    <td>{{nombre_completo}}</td>
                    <td>@{{usuario}}</td>
                    <td>{{email}}</td>
                    <td>
                        {{#cuenta_validada}}
                            <span class="badge badge-active">Validada</span>
                        {{/cuenta_validada}}
                        {{^cuenta_validada}}
                            <span class="badge badge-reported">Sin Validar</span>
                        {{/cuenta_validada}}
                    </td>
                    <td>
                        <form method="POST" action="/admin/cambiarRolUsuario" style="display:flex; gap:6px; align-items:center;">
                            <input type="hidden" name="id" value="{{id}}">
                            <select name="rol" style="min-width: 120px; padding: 6px 10px; border-radius: 6px; border: 1px solid #ccc; font-size: 0.9rem;">
                                <option value="usuario" {{#rol_es_usuario}}selected{{/rol_es_usuario}}>Usuario</option>
                                <option value="admin"   {{#rol_es_admin}}selected{{/rol_es_admin}}>Admin</option>
                                <option value="editor"  {{#rol_es_editor}}selected{{/rol_es_editor}}>Editor</option>
                            </select>
                            <button type="submit" class="btn-admin btn-admin-secondary" style="padding: 5px 10px;" title="Guardar rol">
                                <span class="material-symbols-outlined" style="font-size: 18px;">save</span>
                            </button>
                        </form>
                    </td>
                    <td><strong>{{puntaje}} Tkn</strong></td>
                    <td>
                        <a href="/admin/eliminarUsuario?id={{id}}" class="btn-admin btn-admin-danger" style="padding: 5px 10px;" onclick="return confirm('¿Estás seguro de que deseas eliminar permanentemente este usuario y todo su historial de partidas?')" title="Eliminar Usuario">
                            <span class="material-symbols-outlined" style="font-size: 18px;">delete</span>
                        </a>
                    </td>
                </tr>
                {{/usuarios}}
            </tbody>
        </table>
    </div>
</div>

{{>footer}}
