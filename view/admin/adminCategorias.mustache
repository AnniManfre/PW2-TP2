{{>header}}

<link rel="stylesheet" href="/public/styles/admin.css">

<div class="admin-section">
    <div class="admin-header">
        <div>
            <h1>🎨 Administrar Categorías</h1>
            <p>Listado de categorías disponibles en Trivia Clash</p>
        </div>
        <div>
            <a href="/{{base}}/agregarCategoria" class="btn-admin btn-admin-primary">
                <span class="material-symbols-outlined">add</span>
                Agregar Categoría
            </a>
            <a href="/{{base}}/dashboard" class="btn-admin btn-admin-secondary">
                <span class="material-symbols-outlined">arrow_back</span>
                Panel de Control
            </a>
        </div>
    </div>

    {{#mensaje}}
        <div class="alert-box alert-{{mensaje_clase}}">
            <span class="material-symbols-outlined">check_circle</span>
            {{mensaje}}
        </div>
    {{/mensaje}}

    <div class="table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Color</th>
                    <th>Nombre</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                {{#categorias}}
                <tr>
                    <td><strong>#{{id}}</strong></td>
                    <td>
                        <span class="badge" style="background-color: {{color}}22; color: {{color}}; border: 1px solid {{color}};">
                            {{color}}
                        </span>
                    </td>
                    <td>{{nombre}}</td>
                    <td>
                        <div class="action-buttons">
                            <a href="/{{base}}/editarCategoria?id={{id}}" class="btn-admin btn-admin-secondary" title="Editar">
                                <span class="material-symbols-outlined">edit</span>
                            </a>
                            <a href="/{{base}}/eliminarCategoria?id={{id}}" class="btn-admin btn-admin-danger" onclick="return confirm('¿Estás seguro? Si eliminás esta categoría, las preguntas asociadas quedarán sin categoría.')" title="Eliminar">
                                <span class="material-symbols-outlined">delete</span>
                            </a>
                        </div>
                    </td>
                </tr>
                {{/categorias}}
                {{^categorias}}
                <tr>
                    <td colspan="4" style="text-align: center; padding: 30px; color: var(--on-surface-variant);">
                        No hay categorías en el sistema.
                    </td>
                </tr>
                {{/categorias}}
            </tbody>
        </table>
    </div>
</div>

{{>footer}}
