        </a>

        <a href="/editor/sugeridas" class="menu-card">
            <span>💡</span>
            <h2>Preguntas Sugeridas</h2>
            <p>Revisar propuestas de usuarios.</p>
        </a>

    </div>

    <div style="margin-top: 30px;">
        <a href="/user/logout" class="menu-card" style="display:inline-block;">
            🚪 Cerrar sesión
        </a>
    </div>

</div>

{{>footer}}
