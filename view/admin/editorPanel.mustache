{{>header}}

<link rel="stylesheet" href="/public/styles/dashboard.css">

<div class="dashboard">

    <h1>Panel de Editor</h1>
    <p>Bienvenido {{staff}}</p>

    <div class="menu-grid">

        <a href="/editor/preguntas" class="menu-card">
            <span>📚</span>
            <h2>Administrar Preguntas</h2>
            <p>Editar y eliminar preguntas.</p>
        </a>

        <a href="/editor/agregarPregunta" class="menu-card">
            <span>➕</span>
            <h2>Agregar Pregunta</h2>
