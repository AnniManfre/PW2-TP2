{{>header}}

<link rel="stylesheet" href="/public/styles/admin.css">

<div class="admin-section">
    <div class="admin-header">
        <div>
            <h1>📚 Administrar Preguntas</h1>
            <p>Listado de preguntas activas en Trivia Clash</p>
        </div>
        <div>
            <a href="/{{base}}/agregarPregunta" class="btn-admin btn-admin-primary">
                <span class="material-symbols-outlined">add</span>
                Agregar Pregunta
            </a>
            <a href="/{{base}}/dashboard" class="btn-admin btn-admin-secondary">
                <span class="material-symbols-outlined">arrow_back</span>
                Panel de Control
            </a>
        </div>
    </div>

    {{#mensaje}}
        <div class="alert-box alert-{{mensaje_clase}}">
            <span class="material-symbols-outlined">
                {{#mensaje_clase}}check_circle{{/mensaje_clase}}
            </span>
            {{mensaje}}
        </div>
    {{/mensaje}}

    <div class="table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Categoría</th>
                    <th>Nivel</th>
                    <th>Pregunta</th>
                    <th>Respuesta Correcta</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                {{#preguntas}}
                <tr>
                    <td><strong>#{{id}}</strong></td>
                    <td>
                        <span class="badge" style="background-color: {{color}}22; color: {{color}}; border: 1px solid {{color}};">
                            {{categoria_nombre}}
                        </span>
                    </td>
                    <td>
                        <span style="background-color: {{nivel_color}}22;color: {{nivel_color}};border: 1px solid {{nivel_color}};padding: 2px 10px;border-radius: 20px;font-size: 0.85rem;">
                         {{nivel}}
                        </span>
                    </td>
                    <td>{{pregunta}}</td>
                    <td><span class="badge badge-active">{{respuesta_correcta}}</span></td>
                    <td>
                        <div class="action-buttons">
                            <a href="/{{base}}/editarPregunta?id={{id}}" class="btn-admin btn-admin-secondary" title="Editar">
                                <span class="material-symbols-outlined">edit</span>
                            </a>
                            <a href="/{{base}}/eliminarPregunta?id={{id}}" class="btn-admin btn-admin-danger" onclick="return confirm('¿Estás seguro de que deseas eliminar esta pregunta?')" title="Eliminar">
                                <span class="material-symbols-outlined">delete</span>
                            </a>
                        </div>
                    </td>
                </tr>
                {{/preguntas}}
                {{^preguntas}}
                <tr>
                    <td colspan="6" style="text-align: center; padding: 30px; color: var(--on-surface-variant);">
                        No hay preguntas activas en el sistema.
                    </td>
                </tr>
                {{/preguntas}}
            </tbody>
        </table>
    </div>
</div>

{{>footer}}
