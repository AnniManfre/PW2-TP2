{{>header}}

<link rel="stylesheet" href="/public/styles/jugar.css">


<div class="question-card">
    <div class="category-bar" style="background: {{color}}">
        {{categoria}}
    </div>

    <div class="question-header">
        <span class="question-counter">Pregunta {{numero_pregunta}} de {{total_preguntas}}</span>
        <span class="nivel-badge nivel-{{nivel}}">Nivel {{nivel}} · {{nivel_nombre}}</span>
        <span class="question-score">Puntaje: {{puntaje}}</span>
    </div>

    <div class="timer-container">
        ⏱️ Tiempo restante:
        <span id="timer">{{tiempo_restante}}</span>s
    </div>

    <div class="progress-bar">
        <div class="progress-fill" style="width: {{progreso}}%"></div>
    </div>

    {{#mensaje}}
        <div class="message message-{{mensaje_tipo}}">
            {{mensaje}}
        </div>
    {{/mensaje}}

    <h2 class="question-text">
        {{pregunta}}
    </h2>

    <form method="POST" action="/partida/responder">
        <input type="hidden" name="timeout" id="timeout" value="0">
        {{#opciones}}
        <button type="submit" name="respuesta" value="{{valor}}" class="option-btn">
            <span class="option-letter">{{letra}}</span>
            <span class="option-text">{{texto}}</span>
        </button>
        {{/opciones}}
    </form>
    <a href="/partida/abandonar" class="btn-abandonar">Abandonar Partida</a>
</div>


<script>
    window.addEventListener('load', function() {
        const pos = sessionStorage.getItem('scrollPos');
        if (pos) window.scrollTo(0, parseInt(pos));
        sessionStorage.removeItem('scrollPos');
    });
    document.querySelectorAll('.option-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            sessionStorage.setItem('scrollPos', window.scrollY);
        });
    });
</script>

<script>
let tiempo = {{tiempo_restante}};

const intervalo = setInterval(() => {

    tiempo--;

    document.getElementById("timer").textContent = tiempo;

    if (tiempo <= 0) {

        clearInterval(intervalo);

        document.getElementById("timeout").value = "1";

        document.querySelector("form").submit();
    }

}, 1000);
</script>

{{>footer}}
