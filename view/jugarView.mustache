{{>header}}

<link rel="stylesheet" href="/PW2-TP2/public/styles/jugar.css">

<div class="container">
    <div class="question-card">
        <div class="category-bar" style="background: {{color}}">
            {{categoria}}
        </div>

        <div class="question-header">
            <span class="question-counter">Pregunta {{numero_pregunta}} de {{total_preguntas}}</span>
            <span class="question-score">Puntaje: {{puntaje}}</span>
        </div>

        <div class="progress-bar">
            <div class="progress-fill" style="width: {{progreso}}%"></div>
        </div>

        {{#mensaje}}
            <div class="message message-{{mensaje_tipo}}">
                {{mensaje}}
            </div>
        {{/mensaje}}

        <h2 class="question-text">
            {{pregunta}}
        </h2>

        <form method="POST" action="/PW2-TP2/partida/responder">
            <button type="submit" name="respuesta" value="a" class="option-btn">
                <span class="option-letter">A</span>
                <span class="option-text">{{a}}</span>
            </button>

            <button type="submit" name="respuesta" value="b" class="option-btn">
                <span class="option-letter">B</span>
                <span class="option-text">{{b}}</span>
            </button>

            <button type="submit" name="respuesta" value="c" class="option-btn">
                <span class="option-letter">C</span>
                <span class="option-text">{{c}}</span>
            </button>

            <button type="submit" name="respuesta" value="d" class="option-btn">
                <span class="option-letter">D</span>
                <span class="option-text">{{d}}</span>
            </button>
        </form>
    </div>
</div>

{{>footer}}