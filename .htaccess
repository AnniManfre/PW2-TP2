<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Si la solicitud es para un archivo o carpeta real, no aplicar rewrite
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Reescribir las solicitudes a index.php
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>
